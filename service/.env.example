# Public address of the service, with its sub-path if it has one.
TRIBUNE_PUBLIC_URL=https://feedback.example.com
# Long random string: signs unsubscribe links.  openssl rand -hex 32
TRIBUNE_SECRET=
# Database password for the bundled PostgreSQL.  openssl rand -hex 16
POSTGRES_PASSWORD=
# Mail: log (prints only), file (writes JSON to MAIL_DIR), smtp, resend
MAIL_MODE=log
MAIL_FROM=Idées <no-reply@example.com>
# SMTP_URL=smtps://user:password@smtp.example.com:465
# RESEND_API_KEY=
TRIBUNE_PORT=8790
